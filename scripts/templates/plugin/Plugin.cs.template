using SaveToolkit.Sdk;
using SaveToolkit.Sdk.Saves;

namespace @PROJECT@;

public sealed class @NAME@Plugin : IGamePlugin
{
    internal static ReadOnlySpan<byte> ExampleMagic => "STKDEMO1"u8;
    internal const int MaximumRecords = 64;
    internal const int MaximumFileBytes = 1024 * 1024;

    public PluginInfo Info { get; } = new("@ID@", @GAME_LITERAL@, "0.1.0")
    {
        Description = "Synthetic scaffold example only; no real game format implemented.",
        Games = [@GAMES@],
        Maturity = PluginMaturity.ReadOnly,
    };

    // TODO: research the real format and replace this synthetic signature and parser together.
    // Title IDs alone never establish format support.
    public ProbeResult Probe(ISaveFile file) =>
        file.Length <= MaximumFileBytes && file.ReadHeader(ExampleMagic.Length).AsSpan().SequenceEqual(ExampleMagic)
            ? ProbeResult.Match(ProbeScore.Format, "Synthetic scaffold example")
            : ProbeResult.None;

    public ISaveDocument Open(ISaveFile file)
    {
        if (file.Length > MaximumFileBytes)
            throw new SaveFormatException("Synthetic example exceeds the file size limit.");
        return new @NAME@Document(file.RelativePath, file.ReadAllBytes());
    }
}
