<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SaveToolkit.Plugins.FinalFantasy7</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Plugins depend on the SDK only (never on Core/Api). -->
    <ProjectReference Include="..\..\..\src\SaveToolkit.Sdk\SaveToolkit.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/names.json" />
    <EmbeddedResource Include="Resources/equipment.json" />
    <EmbeddedResource Include="Resources/character-curves.json" />
    <EmbeddedResource Include="Resources/*-progress.json" />
    <EmbeddedResource Include="Resources/rebirth-folios.json" />
    <EmbeddedResource Include="Resources/rebirth-research.json" />
    <EmbeddedResource Include="Resources/*-enemies.json" />
    <EmbeddedResource Include="ReferencePacks/ff7r.remake.en/**/*" LogicalName="refpacks/ff7r.remake.en/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="ReferencePacks/ff7r.rebirth.en/**/*" LogicalName="refpacks/ff7r.rebirth.en/%(RecursiveDir)%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="SaveToolkit.Plugins.FinalFantasy7.Tests" />
  </ItemGroup>
</Project>
