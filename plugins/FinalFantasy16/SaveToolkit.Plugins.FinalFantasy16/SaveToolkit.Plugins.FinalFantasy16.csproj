    <EmbeddedResource Include="ReferencePacks\ffxvi.nex.en\*" LogicalName="refpacks/ffxvi.nex.en/%(Filename)%(Extension)" />
    <EmbeddedResource Include="ReferencePacks\ffxvi.feats.en\*" LogicalName="refpacks/ffxvi.feats.en/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Plugins depend on the SDK only (never on Core/Api). -->
    <ProjectReference Include="..\..\..\src\SaveToolkit.Sdk\SaveToolkit.Sdk.csproj" />
  </ItemGroup>
</Project>
