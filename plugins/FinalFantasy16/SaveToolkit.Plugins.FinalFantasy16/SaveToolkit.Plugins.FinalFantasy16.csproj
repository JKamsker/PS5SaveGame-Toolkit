<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SaveToolkit.Plugins.FinalFantasy16</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="ReferencePacks\ffxvi.maps.en\*" LogicalName="refpacks/ffxvi.maps.en/%(Filename)%(Extension)" />
    <EmbeddedResource Include="ReferencePacks\ffxvi.published.en\*" LogicalName="refpacks/ffxvi.published.en/%(Filename)%(Extension)" />
    <EmbeddedResource Include="ReferencePacks\ffxvi.abilities.en\*" LogicalName="refpacks/ffxvi.abilities.en/%(Filename)%(Extension)" />
