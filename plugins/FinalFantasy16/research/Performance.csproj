<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Match the existing friend assembly; run in D: scratch, never the test output directory. -->
    <AssemblyName>SaveToolkit.Plugins.FinalFantasy16.Tests</AssemblyName>
    <PluginProject Condition="'$(PluginProject)' == ''">$(RepoRoot)/plugins/FinalFantasy16/SaveToolkit.Plugins.FinalFantasy16/SaveToolkit.Plugins.FinalFantasy16.csproj</PluginProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="MeasurePerformance.cs" />
    <Compile Include="$(RepoRoot)/plugins/FinalFantasy16/SaveToolkit.Plugins.FinalFantasy16.Tests/FaithTestData.cs" Link="FaithTestData.cs" />
    <ProjectReference Include="$(PluginProject)" />
    <ProjectReference Include="$(RepoRoot)/src/SaveToolkit.Testing/SaveToolkit.Testing.csproj" />
  </ItemGroup>
</Project>
