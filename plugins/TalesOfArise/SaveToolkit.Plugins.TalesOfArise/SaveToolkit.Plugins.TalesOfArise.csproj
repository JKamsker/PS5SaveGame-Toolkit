<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SaveToolkit.Plugins.TalesOfArise</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\Sections.csv" />
    <EmbeddedResource Include="Resources\Consumables.csv" />
    <EmbeddedResource Include="Resources\Characters.csv" />
    <EmbeddedResource Include="Resources\EvidenceLedger.csv" />
    <EmbeddedResource Include="ReferencePacks\**\*" LogicalName="refpacks/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Update="ReferencePacks\talesofarise.catalog\source-revisions.json" LogicalName="refpacks/talesofarise.catalog/source-revisions.json" />
    <EmbeddedResource Update="ReferencePacks\talesofarise.catalog\asset-sources.json" LogicalName="refpacks/talesofarise.catalog/asset-sources.json" />
    <InternalsVisibleTo Include="SaveToolkit.Plugins.TalesOfArise.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Plugins depend on the SDK only (never on Core/Api). -->
    <ProjectReference Include="..\..\..\src\SaveToolkit.Sdk\SaveToolkit.Sdk.csproj" />
  </ItemGroup>
</Project>
